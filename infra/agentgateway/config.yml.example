# Example agentgateway configuration for one OpenAI-compatible endpoint.
#
# This file is a complete, standalone reference. The active configuration is
# generated from .env into infra/agentgateway/config.yml by:
#
#   make gateway-config
#
# Do not put real API keys in this file. The provider key is resolved from the
# agentgateway process environment via $LLM_UPSTREAM_API_KEY.
#
# To use a different endpoint, change params.baseUrl below. For example:
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenAI:     https://api.openai.com/v1
#   Ollama:     http://host.containers.internal:11434/v1

config:
  adminAddr: "0.0.0.0:15000"

frontendPolicies:
  tracing:
    host: "$MLFLOW_OTLP_HOST:$MLFLOW_OTLP_PORT"
    path: /v1/traces
    protocol: http
    randomSampling: true
    policies:
      backendAuth:
        credentials:
          - key: "$MLFLOW_EXPERIMENT_ID"
            location:
              header:
                name: x-mlflow-experiment-id

gateways:
  default:
    port: 8091

llm:
  policies:
    apiKey:
      mode: strict
      keys:
        - key: "$LLM_GATEWAY_VIRTUAL_KEY"
          metadata:
            name: kafkallm-worker
    cors:
      allowOrigins:
        - http://127.0.0.1:15000
        - http://localhost:15000
      allowMethods:
        - GET
        - POST
        - OPTIONS
      allowHeaders:
        - Authorization
        - Content-Type
        - Accept
      maxAge: 10m
  providers:
    - name: upstream
      provider:
        custom:
          formats:
            - type: completions
      params:
        baseUrl: https://openrouter.ai/api/v1
        apiKey: "$LLM_UPSTREAM_API_KEY"
      # For self-signed endpoints only:
      # defaults:
      #   tls:
      #     insecure: true
  models:
    - name: openai/gpt-4.1-mini
      provider:
        reference: upstream
    - name: "*"
      provider:
        reference: upstream
