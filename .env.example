# --- goose job runtime -------------------------------------------------------
# Model used by the goose microVMs. The gateway always speaks the OpenAI
# protocol to goose; the upstream provider is configured below.
# Pick a model with reliable tool calling. Small free models may ignore the
# goosetown delegation workflow.
# GOOSE_PROVIDER is optional (telemetry label). It defaults to
# LLM_UPSTREAM_PROVIDER when unset.
# GOOSE_PROVIDER=openrouter
GOOSE_MODEL=nvidia/nemotron-3.5-lightning:free
GOOSE_STARTUP_TIMEOUT_SECONDS=300
# Build this image into the rootless Podman storage first:
#   ./scripts/build-goose-image.sh
GOOSE_IMAGE=kafkallm-goose-job:latest
# Built by scripts/build-rea-image.sh; used only by jobs with sandbox=reverse.
GOOSE_RE_IMAGE=kafkallm-rea-job:latest
# Rootless Podman API socket (systemctl --user enable --now podman.socket).
# Adjust the UID in the path if your user is not 1000.
PODMAN_SOCKET=/run/user/1000/podman/podman.sock
# Host directory shared by the worker and the microVMs.
KAFKALLM_JOB_ROOT=/var/lib/kafkallm
GOOSE_JOB_WORKSPACE_ROOT=/var/lib/kafkallm/jobs
GOOSE_JOB_SKILLS_DIR=/var/lib/kafkallm/skills
# Optional drop-in agent profiles (*.md with YAML front matter).
# The GUI imports them into agents.state on startup; the filename is the agent_id.
GOOSE_JOB_AGENTS_DIR=/var/lib/kafkallm/agents
# Read-only sandbox extras. Put static binaries/tools in tools/bin and a goose
# config.yaml with MCP extensions in config/.
GOOSE_JOB_TOOLS_DIR=/var/lib/kafkallm/tools
GOOSE_JOB_CONFIG_DIR=/var/lib/kafkallm/config
WORKSPACE_ROOT=/var/lib/kafkallm/staging
# One microVM per job. Reverse-engineering jobs run Ghidra in the guest, so
# budget at least 4096 MiB and a higher container limit when you use
# sandbox=reverse (for example GOOSE_JOB_MEMORY_LIMIT=6g).
GOOSE_JOB_RAM_MIB=2048
GOOSE_JOB_CPUS=2
GOOSE_JOB_MEMORY_LIMIT=4g
GOOSE_JOB_PIDS_LIMIT=512
GOOSE_JOB_TMPFS_SIZE=1g
GOOSE_JOB_MAX_TURNS=60
GOOSE_JOB_SUBAGENT_MAX_TURNS=40
# A second, short goose run in a separate microVM that may improve the
# persistent skills. The worker validates and merges its changes.
GOOSE_JOB_REFLECT_ENABLED=true
GOOSE_JOB_REFLECT_TIMEOUT_SECONDS=300
# Use passt networking instead of the default TSI.
GOOSE_JOB_USE_PASST=false
MAX_JOB_TIMEOUT_SECONDS=1800
MAX_AGENT_STEPS=8
# Opt-in unlimited jobs. When enabled, the GUI/CLI can mark a job as unlimited:
# no job timeout, no Goose turn cap, and large results are preserved as a
# result-full.md artifact instead of failing the Kafka message limit.
# Set this on both the GUI and worker services.
ALLOW_UNLIMITED_JOBS=false
# Kafka-safe result text cap. Larger unlimited results go to S3 as an artifact.
MAX_RESULT_BYTES=500000
# 0 disables the output-file count cap (unlimited mode always disables it).
MAX_OUTPUT_FILES=100
UNLIMITED_MAX_TURNS=100000
UNLIMITED_MAX_SUBAGENT_TURNS=100000
# 24 hours is the maximum librdkafka accepts. The worker still polls the
# consumer while a job runs, so this is only a safety ceiling.
UNLIMITED_MAX_POLL_INTERVAL_MS=86400000
# The worker talks to the rootless Podman API through the Compose proxy.
GOOSE_JOB_DOCKER_HOST=tcp://127.0.0.1:2375

# --- agentgateway LLM gateway ------------------------------------------------
# The gateway holds the real provider key. Jobs authenticate with a rotatable
# virtual key and never see the provider credential.
#
# Choose the upstream provider here. agentgateway/config.generated.yaml is
# rendered from these values by scripts/render-agentgateway-config.sh; run
# 'make gateway-config' after editing, or simply 'make up'.
# 'make setup' in a terminal asks for the provider, key/base URL, and model
# interactively and writes the values below.
#
# Common setups:
#   OpenRouter:  LLM_UPSTREAM_PROVIDER=openrouter
#                LLM_UPSTREAM_API_KEY=sk-or-...
#   OpenAI:      LLM_UPSTREAM_PROVIDER=openai
#                LLM_UPSTREAM_API_KEY=sk-...
#   Ollama:      LLM_UPSTREAM_PROVIDER=ollama
#                LLM_UPSTREAM_BASE_URL=http://host.containers.internal:11434/v1
#                (no API key needed)
#   Custom OpenAI-compatible / self-hosted:
#                LLM_UPSTREAM_PROVIDER=openai
#                LLM_UPSTREAM_BASE_URL=https://llm.example.com/v1
#                LLM_UPSTREAM_API_KEY=...
#   Custom non-OpenAI wire format:
#                LLM_UPSTREAM_PROVIDER=custom
#                LLM_UPSTREAM_FORMAT=completions
#                LLM_UPSTREAM_BASE_URL=https://llm.example.com/v1
#
# Supported presets include openrouter, openai, ollama, anthropic, gemini,
# groq, mistral, deepseek, xai, cerebras, togetherai, fireworks, perplexity,
# cohere, huggingface, baseten, deepinfra, nebius, meta, typesafe, azure,
# bedrock, vertex, and copilot. Cloud providers may need extra parameters in
# agentgateway/config.template.yaml.
LLM_UPSTREAM_PROVIDER=openrouter
# Leave empty to use the provider's default endpoint. Ollama defaults to the
# host at http://host.containers.internal:11434/v1.
# Ollama never receives LLM_UPSTREAM_API_KEY; use provider=custom for an
# authenticated Ollama-compatible endpoint.
LLM_UPSTREAM_BASE_URL=
# The provider API key lives only in the gateway container. The legacy name
# OPENROUTER_API_KEY is still accepted for OpenRouter.
LLM_UPSTREAM_API_KEY=
# Only used by LLM_UPSTREAM_PROVIDER=custom. See PROVIDER_FORMATS in
# src/kafkallm/agentgateway_config.py.
LLM_UPSTREAM_FORMAT=completions
# Generate/rotate the virtual key jobs use: openssl rand -hex 32
# After changing it, run 'make gateway-config' (or 'make up') so the generated
# config and the admin playground use the new key.
LLM_GATEWAY_VIRTUAL_KEY=change-me-to-a-long-random-string
# Write the resolved virtual key into the gitignored generated config so the
# admin playground's "Virtual API key" selection works. Set false to keep only
# the $LLM_GATEWAY_VIRTUAL_KEY reference and use "Raw value" in the playground.
AGENTGATEWAY_INLINE_VIRTUAL_KEY=true
# URL the job microVM uses. host.containers.internal is overridden per job to
# the IPv6 address of the allowlisting proxy on the isolated job network.
LLM_GATEWAY_URL=http://host.containers.internal:8091
# Host interface and port for the published agentgateway listener. 0.0.0.0 is
# required because rootless Podman reaches host services through a non-loopback
# pasta address. The virtual key is the access control.
LLM_GATEWAY_BIND=0.0.0.0
# The gateway listens on this port inside the container and publishes the same
# port on the host. The browser playground uses it, as do jobs and clients.
LLM_GATEWAY_PORT=8091
# agentgateway admin/UI and LLM playground, published on 127.0.0.1 only.
AGENTGATEWAY_UI_PORT=15000
# Browser origins allowed to call the LLM listener. The playground is served
# from the admin UI origin, so it needs an entry here. Use a comma-separated
# list; an empty value disables CORS.
AGENTGATEWAY_CORS_ORIGINS=http://127.0.0.1:15000,http://localhost:15000
# The worker polls this URL over the Compose network.
LLM_GATEWAY_READY_URL=http://llm-gateway:15021/healthz/ready

# --- isolated job network ----------------------------------------------------
# Jobs run on an IPv6-only internal Podman network. The allowlisting proxy is
# the only peer on that network and forwards only to agentgateway.
# Create it once on the host: ./scripts/init-job-network.sh
GOOSE_JOB_NETWORK=kafkallm-jobs
GOOSE_JOB_NETWORK_SUBNET=fd00:6b61:666b:616c::/64
# Leave empty to pick the next free podmanN interface automatically.
GOOSE_JOB_NETWORK_INTERFACE=
# The worker runs in a container, so it only verifies this host-side network.
GOOSE_JOB_NETWORK_AUTOCREATE=false
# The proxy is created on this ordinary Podman network first, then connected to
# the internal job network.
GOOSE_JOB_PROXY_NETWORK=podman
GOOSE_JOB_PROXY_UPSTREAM_HOST=host.containers.internal
GOOSE_JOB_PROXY_UPSTREAM_PORT=8091

# --- Kafka -------------------------------------------------------------------
# The Compose stack runs Apache Kafka (KRaft). Containers use kafka:9092;
# host tools and the CLI use localhost:19092.
JOBS_TOPIC=jobs.in
RESULTS_TOPIC=jobs.out
# Compacted materialized state for the GUI. Kafka is the only database.
STATE_TOPIC=jobs.state
EVENTS_TOPIC=agent.events
# Compacted goosetown agent registry managed by the GUI.
AGENTS_TOPIC=agents.state
# Compacted sandbox/environment registry managed by the GUI.
SANDBOXES_TOPIC=sandboxes.state
# One-shot cancellation requests published by the GUI.
CANCELS_TOPIC=jobs.cancel
# Live job activity (thinking, tool calls, stderr) for the GUI.
LOGS_TOPIC=jobs.logs
# Number of parallel job slots inside one worker process. Effective parallelism
# is min(WORKER_CONCURRENCY, KAFKA_TOPIC_PARTITIONS).
WORKER_CONCURRENCY=1
KAFKA_GROUP_ID=agent-workers
KAFKA_TOPIC_PARTITIONS=3
# Seven days. Compacted state topics ignore this retention.
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_STARTUP_TIMEOUT_SECONDS=300

# --- GUI ---------------------------------------------------------------------
# The GUI listens on 0.0.0.0 inside the container; Compose publishes it on
# 127.0.0.1 only.
GUI_HOST=0.0.0.0
GUI_PORT=8090
# Upper bound for JSON request bodies (job, agent, and sandbox writes).
# File uploads use the UPLOAD_MAX_* limits below instead.
GUI_MAX_REQUEST_BYTES=2097152
# Uploaded inputs are stored in S3/RustFS and copied into /workspace/inputs.
UPLOAD_MAX_FILES=16
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_TOTAL_BYTES=104857600

# --- storage profile ---------------------------------------------------------
# Used for input files and result artifacts.
S3_ENDPOINT_URL=http://rustfs:9000
# Local RustFS development credentials; change for production use.
S3_ACCESS_KEY_ID=rustfs
S3_SECRET_ACCESS_KEY=kafkallm-secret
S3_BUCKET=jobs
S3_REGION=local
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# --- observability -----------------------------------------------------------
AGENT_NAME=agent-worker
# MLflow runs as one container with SQLite and ingests OTLP/HTTP traces.
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_OTLP_HOST=mlflow
MLFLOW_OTLP_PORT=5000
MLFLOW_EXPERIMENT_ID=0
MLFLOW_UI_PORT=5000
# Prompt and tool content is excluded unless explicitly enabled.
TELEMETRY_CAPTURE_CONTENT=false
