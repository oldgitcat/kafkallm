# Use Hermes Agent for execution. Set to "local" for the built-in Echo harness.
# "hermes" runs a shared Hermes gateway; "hermes-job" runs one disposable
# Hermes container per job and keeps learned skills in HERMES_SKILLS_VOLUME.
AGENT_RUNTIME=hermes
HERMES_API_KEY=change-me-local-dev
HERMES_MODEL=
HERMES_PROVIDER=
HERMES_STARTUP_TIMEOUT_SECONDS=300
# Used by AGENT_RUNTIME=hermes-job.
HERMES_IMAGE=nousresearch/hermes-agent@sha256:9c5561579f3ffdf333401797094ac3a743738d6c25d40f4331c7bf77b694238d
HERMES_SKILLS_VOLUME=hermes-skills
HERMES_JOB_TMPFS_SIZE=1g
HERMES_JOB_MAX_TURNS=100
HERMES_JOB_REFLECT_ENABLED=true
HERMES_JOB_REFLECT_TIMEOUT_SECONDS=300
# The worker reaches Docker through the local socket proxy (never expose it).
DOCKER_HOST=tcp://docker-proxy:2375
# Provider credentials used by the Hermes containers.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
NOUS_API_KEY=

# Used only when AGENT_RUNTIME=local.
LLM_PROVIDER=echo
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Used by the storage profile for input files and result artifacts.
S3_ENDPOINT_URL=http://rustfs:9000
# Local RustFS development credentials; change for production use.
S3_ACCESS_KEY_ID=rustfs
S3_SECRET_ACCESS_KEY=hermes-secret
S3_BUCKET=jobs
S3_REGION=local
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Local trace and audit observability.
EVENTS_TOPIC=agent.events
AGENT_NAME=agent-worker
KAFKA_STARTUP_TIMEOUT_SECONDS=300
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=hermes
PHOENIX_UI_PORT=6006
OTLP_GRPC_PORT=4317
# Enable only if prompts and tool data may be stored in Phoenix.
PHOENIX_CAPTURE_CONTENT=false
