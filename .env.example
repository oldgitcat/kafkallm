# Gänsestall environment file. Copy to .env (make setup does this) and edit.
# .env is gitignored. Defaults live in backend/gaensestall/core/settings.py; only set
# what you need to override. Empty values fall back to those defaults.

# --- model and job runtime ---------------------------------------------------
# Jobs talk to the MLflow AI Gateway endpoint named below. Keep GOOSE_MODEL
# equal to MLFLOW_GATEWAY_ENDPOINT; the provider model id lives in
# LLM_UPSTREAM_MODEL.
GOOSE_MODEL=gaensestall
# Optional telemetry label; defaults to "openai-compatible".
# GOOSE_PROVIDER=openai-compatible
GOOSE_STARTUP_TIMEOUT_SECONDS=300
# Build these with ./scripts/build-goose-image.sh / build-rea-image.sh /
# build-llm-proxy-image.sh.
GOOSE_IMAGE=gaensestall-goose-job:latest
GOOSE_RE_IMAGE=gaensestall-rea-job:latest
LLM_PROXY_IMAGE=gaensestall-llm-proxy:latest
# Rootless Podman API socket (systemctl --user enable --now podman.socket).
# Adjust the UID if your user is not 1000. The worker talks to this socket
# directly; there is no TCP socket proxy.
PODMAN_SOCKET=/run/user/1000/podman/podman.sock
# Per-user data root. The worker, the GUI, and the job microVMs all use this
# directory. Defaults to ~/.local/share/gaensestall; set an absolute path to
# override it. No sudo and no world-writable modes are needed.
# GAENSESTALL_JOB_ROOT=/absolute/path
# Optional: override the host directory copied into each job as its Goose
# config. The active file inside it must be named config.yaml.
# GOOSE_JOB_CONFIG_DIR=/absolute/path
GOOSE_JOB_DEFAULT_AGENTS_DIR=goose-assets/agents
GOOSE_JOB_RAM_MIB=2048
GOOSE_JOB_CPUS=2
GOOSE_JOB_MEMORY_LIMIT=4g
GOOSE_JOB_PIDS_LIMIT=512
GOOSE_JOB_MAX_TURNS=60
GOOSE_JOB_SUBAGENT_MAX_TURNS=40
GOOSE_JOB_REFLECT_ENABLED=true
GOOSE_JOB_REFLECT_TIMEOUT_SECONDS=300
GOOSE_JOB_USE_PASST=false
MAX_JOB_TIMEOUT_SECONDS=1800
ALLOW_UNLIMITED_JOBS=false
MAX_RESULT_BYTES=500000
MAX_OUTPUT_FILES=100
UNLIMITED_MAX_TURNS=100000
UNLIMITED_MAX_SUBAGENT_TURNS=100000
UNLIMITED_MAX_POLL_INTERVAL_MS=86400000

# --- MLflow AI Gateway -------------------------------------------------------
# Any OpenAI-compatible /v1 endpoint works. Examples:
#   OpenRouter: https://openrouter.ai/api/v1
#   OpenAI:     https://api.openai.com/v1
#   Ollama:     http://host.containers.internal:11434/v1
#   Open WebUI: http://host.containers.internal:3000/api
LLM_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
# Provider model id sent upstream, for example an OpenRouter model slug.
LLM_UPSTREAM_MODEL=nvidia/nemotron-3.5-lightning:free
# Stored encrypted in Postgres. Leave empty for unauthenticated local servers.
LLM_UPSTREAM_API_KEY=
# Skip upstream certificate verification for self-signed/private endpoints.
# Keep false for public providers.
LLM_UPSTREAM_INSECURE_SKIP_TLS_VERIFY=false
# MLflow creates this gateway endpoint; jobs use it as GOOSE_MODEL.
MLFLOW_GATEWAY_ENDPOINT=gaensestall
# Generate/rotate with: openssl rand -hex 32
LLM_PROXY_TOKEN=change-me-to-a-long-random-string
# Job-facing proxy. The worker injects this address into the microVM.
LLM_PROXY_URL=http://host.containers.internal:8091
LLM_PROXY_PORT=8091
MLFLOW_READY_URL=http://mlflow:5000/gateway/mlflow/v1/models

# --- isolated job network ----------------------------------------------------
# Create it once on the host: ./scripts/init-job-network.sh
GOOSE_JOB_NETWORK=gaensestall-jobs
GOOSE_JOB_NETWORK_SUBNET=fd00:6b61:666b:616c::/64
# Leave empty to pick the next free podmanN interface.
GOOSE_JOB_NETWORK_INTERFACE=
# Optional host directory for the generated network definition.
GOOSE_JOB_NETWORK_DIR=
GOOSE_JOB_NETWORK_AUTOCREATE=false
# The proxy joins the Compose network so it can resolve `mlflow` without
# publishing the tracking server on the host.
LLM_PROXY_NETWORK=gaensestall
LLM_PROXY_UPSTREAM_HOST=mlflow
LLM_PROXY_UPSTREAM_PORT=5000

# --- Kafka -------------------------------------------------------------------
# Containers use kafka:9092; host tools and the CLI use 127.0.0.1:19092.
# The Compose services override this with kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
JOBS_TOPIC=jobs.in
RESULTS_TOPIC=jobs.out
STATE_TOPIC=jobs.state
EVENTS_TOPIC=agent.events
AGENTS_TOPIC=agents.state
SANDBOXES_TOPIC=sandboxes.state
CONTROL_TOPIC=jobs.control
LOGS_TOPIC=jobs.logs
WORKER_CONCURRENCY=1
KAFKA_GROUP_ID=agent-workers
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_STARTUP_TIMEOUT_SECONDS=300
# Optional stable worker ID; defaults to the container hostname.
WORKER_ID=

# --- GUI ---------------------------------------------------------------------
# Bind address on the host. 0.0.0.0 makes the GUI reachable from the LAN;
# set 127.0.0.1 for local-only access. Caddy adds HTTP basic auth.
GUI_BIND=0.0.0.0
GUI_HOST=0.0.0.0
GUI_PORT=8090
# HTTP basic auth enforced by Caddy. make setup asks for the username and
# password and writes the bcrypt hash here.
GUI_AUTH_USER=
GUI_AUTH_HASH=
GUI_MAX_REQUEST_BYTES=2097152
UPLOAD_MAX_FILES=16
UPLOAD_MAX_FILE_BYTES=52428800
UPLOAD_MAX_TOTAL_BYTES=104857600

# --- storage profile ---------------------------------------------------------
# Used for input files and result artifacts.
S3_ENDPOINT_URL=http://rustfs:9000
S3_ACCESS_KEY_ID=rustfs
S3_SECRET_ACCESS_KEY=gaensestall-secret
S3_BUCKET=jobs
S3_REGION=local
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# --- MLflow storage ----------------------------------------------------------
# Postgres is internal to the Compose network and is not published on the host.
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=gaensestall-mlflow
POSTGRES_DB=mlflow
# Encrypts gateway credentials in the database. Generate a unique value for
# any shared deployment.
MLFLOW_CRYPTO_KEK_PASSPHRASE=gaensestall-local-kek
# For local HTTP or private-IP model servers set:
#   MLFLOW_GATEWAY_API_BASE_ALLOWED_SCHEMES=https,http
#   MLFLOW_GATEWAY_API_BASE_ALLOW_PRIVATE_IPS=true
MLFLOW_GATEWAY_API_BASE_ALLOWED_SCHEMES=https
MLFLOW_GATEWAY_API_BASE_ALLOW_PRIVATE_IPS=false

# --- observability -----------------------------------------------------------
SERVICE_NAME=gaensestall-worker
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_OTLP_HOST=mlflow
MLFLOW_OTLP_PORT=5000
MLFLOW_EXPERIMENT_ID=0
MLFLOW_UI_PORT=5000
TELEMETRY_CAPTURE_CONTENT=false

# --- optional image overrides ------------------------------------------------
# GAENSESTALL_WORKER_IMAGE=gaensestall-worker:latest
# GAENSESTALL_GUI_IMAGE=gaensestall-gui:latest
# GAENSESTALL_MLFLOW_IMAGE=gaensestall-mlflow:latest
# KAFKA_CLUSTER_ID=gaensestall-local-cluster
