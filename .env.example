# Standard: kein API-Key nötig; der Worker beantwortet Jobs mit Echo.
LLM_PROVIDER=echo
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Nur setzen, wenn das storage-Profil verwendet wird.
S3_ENDPOINT_URL=http://rustfs:9000
# Lokale RustFS-Entwicklungszugangsdaten; für produktive Nutzung ändern.
S3_ACCESS_KEY_ID=rustfs
S3_SECRET_ACCESS_KEY=kafkallm-secret
S3_BUCKET=jobs
S3_REGION=local
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Lokale Trace- und Audit-Nachverfolgung.
EVENTS_TOPIC=agent.events
AGENT_NAME=agent-worker
KAFKA_STARTUP_TIMEOUT_SECONDS=300
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=kafkallm
PHOENIX_UI_PORT=6006
OTLP_GRPC_PORT=4317
# Erst aktivieren, wenn Prompts/Tool-Daten in Phoenix gespeichert werden dürfen.
PHOENIX_CAPTURE_CONTENT=false
