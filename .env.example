# Job execution. Every job runs in its own KVM microVM through rootless Podman;
# the worker is the only service that talks to Kafka.
HERMES_MODEL=
HERMES_PROVIDER=
HERMES_STARTUP_TIMEOUT_SECONDS=300
HERMES_IMAGE=nousresearch/hermes-agent@sha256:9c5561579f3ffdf333401797094ac3a743738d6c25d40f4331c7bf77b694238d
# Rootless Podman API socket (systemctl --user enable --now podman.socket).
# Adjust the UID in the path if your user is not 1000.
PODMAN_SOCKET=/run/user/1000/podman/podman.sock
# Host directory shared by the worker and the microVMs.
HERMES_JOB_ROOT=/var/lib/hermes
HERMES_JOB_WORKSPACE_ROOT=/var/lib/hermes/jobs
HERMES_JOB_SKILLS_DIR=/var/lib/hermes/skills
WORKSPACE_ROOT=/var/lib/hermes/staging
# One microVM per job.
HERMES_JOB_RAM_MIB=2048
HERMES_JOB_CPUS=2
HERMES_JOB_MEMORY_LIMIT=4g
HERMES_JOB_PIDS_LIMIT=512
HERMES_JOB_TMPFS_SIZE=1g
HERMES_JOB_MAX_TURNS=100
HERMES_JOB_REFLECT_ENABLED=true
HERMES_JOB_REFLECT_TIMEOUT_SECONDS=300
# Use passt networking instead of the default TSI (restores firewall control).
HERMES_JOB_USE_PASST=false
# Provider credentials used by the Hermes microVMs.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
NOUS_API_KEY=

# Used by the storage profile for input files and result artifacts.
S3_ENDPOINT_URL=http://rustfs:9000
# Local RustFS development credentials; change for production use.
S3_ACCESS_KEY_ID=rustfs
S3_SECRET_ACCESS_KEY=hermes-secret
S3_BUCKET=jobs
S3_REGION=local
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Local trace and audit observability.
EVENTS_TOPIC=agent.events
AGENT_NAME=agent-worker
KAFKA_STARTUP_TIMEOUT_SECONDS=300
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=hermes
PHOENIX_UI_PORT=6006
OTLP_GRPC_PORT=4317
# Enable only if prompts and tool data may be stored in Phoenix.
PHOENIX_CAPTURE_CONTENT=false
