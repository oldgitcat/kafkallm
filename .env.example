# Default: no API key needed; the worker answers jobs with Echo.
LLM_PROVIDER=echo
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# Set only when using the storage profile.
S3_ENDPOINT_URL=http://rustfs:9000
# Local RustFS development credentials; change for production use.
S3_ACCESS_KEY_ID=rustfs
S3_SECRET_ACCESS_KEY=kafkallm-secret
S3_BUCKET=jobs
S3_REGION=local
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Local trace and audit observability.
EVENTS_TOPIC=agent.events
AGENT_NAME=agent-worker
KAFKA_STARTUP_TIMEOUT_SECONDS=300
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=kafkallm
PHOENIX_UI_PORT=6006
OTLP_GRPC_PORT=4317
# Enable only if prompts and tool data may be stored in Phoenix.
PHOENIX_CAPTURE_CONTENT=false
