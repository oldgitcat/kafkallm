# Example Goose configuration for a Gänsestall job.
#
# Copy this file to the host directory configured by GOOSE_JOB_CONFIG_DIR:
#
#   ~/.local/share/kafkallm/config/config.yaml
#
# The worker copies that directory into the job microVM at
# /opt/kafkallm/config, and the entrypoint copies it to
# $GOOSE_PATH_ROOT/config before every run. Goose requires the file name
# config.yaml.
#
# Jobs have no internet access. MCP servers must already exist in the job
# image or under GOOSE_JOB_TOOLS_DIR (mounted at /opt/kafkallm/tools).

# Optional general Goose settings. Uncomment the ones you need.
# GOOSE_TEMPERATURE: 0.2
# GOOSE_MAX_TOKENS: 8192
# GOOSE_TOOL_DEFERRAL: lookup
# GOOSE_AUTO_COMPACT_THRESHOLD: 0.9

extensions:
  # A local stdio MCP server. Replace the command with a binary that exists in
  # the job image or under /opt/kafkallm/tools/bin.
  # local-tools:
  #   enabled: true
  #   type: stdio
  #   name: local-tools
  #   cmd: /opt/kafkallm/tools/bin/local-tools-mcp
  #   args: []
  #   envs:
  #     EXAMPLE_SETTING: value
  #   timeout: 300
  #   available_tools: []

  # A remote MCP server requires network access and is not supported by the
  # default offline sandbox. Keep it disabled unless you explicitly provide a
  # route through the allowlisting proxy.
  # remote-tools:
  #   enabled: false
  #   type: streamable_http
  #   name: remote-tools
  #   uri: https://mcp.example.com/mcp
  #   headers: {}
  #   timeout: 300
