# Reverse-engineering job sandbox. It extends the normal goose/goosetown image
# with REA (https://github.com/morluto/rea), Ghidra, Kuna, JADX, Frida, JDK 21,
# and common RE tools. Build it into the rootless Podman storage:
#
#   ./scripts/build-goose-image.sh
#   ./scripts/build-rea-image.sh
#
# Then submit a job with sandbox=reverse. The normal image is unchanged and
# remains the default.
ARG BASE_IMAGE=kafkallm-goose-job:latest

FROM ${BASE_IMAGE} AS downloads
USER root
ARG NODE_VERSION=24.22.2
ARG NODE_SHA256=361718c444e49af2ca5a110c83ba6a8901143f23ab285ebbef0341f391f482a9
ARG JDK_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.13%2B9/OpenJDK21U-jdk_x64_linux_hotspot_21.0.13_9.tar.gz
ARG JDK_SHA256=d7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c
ARG GHIDRA_URL=https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.4_build/ghidra_12.1.4_PUBLIC_20260921.zip
ARG GHIDRA_SHA256=ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db
# REA verifies Kuna 1.833. Use the static musl build so it also runs cleanly
# on the Debian bookworm glibc.
ARG KUNA_VERSION=1.833
ARG KUNA_SHA256=3b3ac75919366f3fe63cbef4af5e357361c865161765d950c038e2397c41729f
# REA expects the jadx-headless-mcp 0.7.1 bridge JAR.
ARG JADX_HEADLESS_VERSION=0.7.1
ARG JADX_HEADLESS_SHA256=6e5eacf500b64292bfb73c49797c1958f6ee44646e43e868039ae7feb573ff75

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/node.tar.gz \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.gz" \
    && echo "${NODE_SHA256}  /tmp/node.tar.gz" | sha256sum -c -
RUN curl -fsSL -o /tmp/jdk.tar.gz "${JDK_URL}" \
    && echo "${JDK_SHA256}  /tmp/jdk.tar.gz" | sha256sum -c -
RUN curl -fsSL -o /tmp/ghidra.zip "${GHIDRA_URL}" \
    && echo "${GHIDRA_SHA256}  /tmp/ghidra.zip" | sha256sum -c -
RUN curl -fsSL -o /tmp/kuna.tar.gz \
      "https://github.com/Noelo-Lab/kuna/releases/download/v${KUNA_VERSION}/kuna-v${KUNA_VERSION}-linux-x86_64-musl.tar.gz" \
    && echo "${KUNA_SHA256}  /tmp/kuna.tar.gz" | sha256sum -c -
RUN curl -fsSL -o /tmp/jadx-headless-mcp.jar \
      "https://github.com/1013503897/jadx-headless-mcp/releases/download/v${JADX_HEADLESS_VERSION}/jadx-headless-mcp-${JADX_HEADLESS_VERSION}-all.jar" \
    && echo "${JADX_HEADLESS_SHA256}  /tmp/jadx-headless-mcp.jar" | sha256sum -c -

FROM ${BASE_IMAGE}
USER root

ARG REA_VERSION=6.8.0
ARG GHIDRA_DIR=ghidra_12.1.4_PUBLIC
ARG GOOSE_JOB_EXTRA_PACKAGES=""

# Ghidra is headless here. The X libraries are still needed by some of its
# support tools; the job has no display and no network. apktool/apksigner cover
# Android packaging, while python3-venv isolates the Frida CLI dependencies.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        apktool \
        apksigner \
        binwalk \
        gdb \
        libx11-6 \
        libxext6 \
        libxi6 \
        libxrender1 \
        libxtst6 \
        ltrace \
        nasm \
        p7zip-full \
        patchelf \
        python3-capstone \
        python3-pefile \
        python3-pwntools \
        python3-pyelftools \
        python3-venv \
        strace \
        yara \
        ${GOOSE_JOB_EXTRA_PACKAGES} \
    && rm -rf /var/lib/apt/lists/*

COPY --from=downloads \
    /tmp/node.tar.gz \
    /tmp/jdk.tar.gz \
    /tmp/ghidra.zip \
    /tmp/kuna.tar.gz \
    /tmp/

COPY --from=downloads \
    /tmp/jadx-headless-mcp.jar \
    /opt/kafkallm/jadx-headless-mcp-all.jar
COPY LICENSE /usr/share/licenses/jadx-headless-mcp/LICENSE

RUN tar -xzf /tmp/node.tar.gz -C /usr/local --strip-components=1 \
    && mkdir -p /opt/java/openjdk \
    && tar -xzf /tmp/jdk.tar.gz -C /opt/java/openjdk --strip-components=1 \
    && unzip -q /tmp/ghidra.zip -d /opt \
    && ln -s "/opt/${GHIDRA_DIR}" /opt/ghidra \
    && rm -f /tmp/node.tar.gz /tmp/jdk.tar.gz /tmp/ghidra.zip

ENV JAVA_HOME=/opt/java/openjdk \
    GHIDRA_INSTALL_DIR=/opt/ghidra \
    REA_KUNA_COMMAND=/usr/local/bin/kuna \
    REA_JADX_MCP_JAR=/opt/kafkallm/jadx-headless-mcp-all.jar \
    PATH=/opt/java/openjdk/bin:/opt/ghidra/support:/usr/local/bin:$PATH

RUN npm install --global --omit=optional "rea-agents@${REA_VERSION}" \
    && npm cache clean --force \
    && rm -rf /root/.npm

# Kuna is pinned to the version REA verifies. Its bundled skill and REA's own
# reverse-engineering skill are seeded only into reverse jobs.
RUN mkdir -p /opt/kuna \
    && tar -xzf /tmp/kuna.tar.gz -C /opt/kuna --strip-components=1 \
    && install -m 0755 /opt/kuna/kuna /usr/local/bin/kuna \
    && mkdir -p /usr/share/licenses/kuna \
    && cp /opt/kuna/LICENSE /opt/kuna/NOTICE /usr/share/licenses/kuna/ \
    && rm -rf /opt/kuna /tmp/kuna.tar.gz \
    && mkdir -p /opt/kafkallm/sandbox-skills \
    && kuna install-skill --dir /opt/kafkallm/sandbox-skills \
    && cp -a /usr/local/lib/node_modules/rea-agents/skills/reverse-engineer-anything \
        /opt/kafkallm/sandbox-skills/

# Keep the standalone Frida CLI available alongside REA's bundled Frida
# bindings. REA uses its own Node integration; this is for manual analysis.
# The REA image is optional; the pinned Python deps live in
# goose_job/requirements-rea.txt.
COPY goose_job/requirements-rea.txt /tmp/requirements-rea.txt
RUN python3 -m venv /opt/frida \
    && /opt/frida/bin/pip install --no-cache-dir --disable-pip-version-check \
        --timeout 120 --retries 10 -r /tmp/requirements-rea.txt \
    && for tool in /opt/frida/bin/frida*; do \
        ln -sf "$tool" /usr/local/bin/; \
    done \
    && rm -f /tmp/requirements-rea.txt

# Goose starts this as a local stdio MCP server with
# --with-extension rea:/opt/kafkallm/rea-mcp.
RUN printf '%s\n' \
        '#!/bin/sh' \
        'set -eu' \
        'export GHIDRA_INSTALL_DIR="${GHIDRA_INSTALL_DIR:-/opt/ghidra}"' \
        'export JAVA_HOME="${JAVA_HOME:-/opt/java/openjdk}"' \
        'export PATH="$JAVA_HOME/bin:$PATH"' \
        'exec /usr/local/lib/node_modules/rea-agents/scripts/rea.mjs mcp' \
        > /opt/kafkallm/rea-mcp \
    && chmod 0755 /opt/kafkallm/rea-mcp

WORKDIR /workspace
CMD ["/bin/sh", "-c", "exec /bin/sh"]
