# Example custom sandbox image. It extends the normal job image with Java and
# Ghidra. Put a Ghidra release zip next to this file or adjust GHIDRA_ZIP.
#
# Build it with:
#   GOOSE_JOB_DOCKERFILE=goose_job/Dockerfile.example \
#     ./scripts/build-goose-image.sh
#
# For lighter tool additions, prefer GOOSE_JOB_EXTRA_PACKAGES in the main
# Dockerfile, or drop static binaries and extracted tools into
# GOOSE_JOB_TOOLS_DIR (/var/lib/kafkallm/tools) on the host.

FROM localhost/kafkallm-goose-job:latest

USER root

ARG GHIDRA_ZIP=goose_job/ghidra.zip

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        unzip \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/kafkallm/tools/bin /opt/kafkallm/tools/ghidra

COPY ${GHIDRA_ZIP} /tmp/ghidra.zip

RUN unzip -q /tmp/ghidra.zip -d /opt/kafkallm/tools/ghidra \
    && ln -s /opt/kafkallm/tools/ghidra/ghidra_*/ghidraRun \
       /opt/kafkallm/tools/bin/ghidraRun \
    && rm -f /tmp/ghidra.zip

ENV PATH=/opt/kafkallm/tools/bin:$PATH
